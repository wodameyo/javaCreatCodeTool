		<result column="price" property="price" />
		<result column="stock" property="stock" />
		<result column="on_sale" property="onSale" />
		<result column="description" property="description" />
		<result column="create_time" property="createTime" />
	</resultMap>

	<!--通用查询结果列-->
	<sql id="Base_Column_List">
		id,product_name,product_code,category,price,stock,on_sale,description,create_time
	</sql>

	<!--基础查询条件-->
	<sql id="Base_Query_Condition">
		<if test="query.id != null">
			and t.id = #{query.id}
		</if>
		<if test="query.productName != null and query.productName != ''">
			and t.product_name = #{query.productName}
		</if>
		<if test="query.productCode != null and query.productCode != ''">
			and t.product_code = #{query.productCode}
		</if>
		<if test="query.category != null and query.category != ''">
			and t.category = #{query.category}
		</if>
		<if test="query.price != null">
			and t.price = #{query.price}
		</if>
		<if test="query.stock != null">
			and t.stock = #{query.stock}
		</if>
		<if test="query.onSale != null">
			and t.on_sale = #{query.onSale}
		</if>
		<if test="query.description != null and query.description != ''">
			and t.description = #{query.description}
		</if>
		<if test="query.createTime != null">
			and t.create_time = #{query.createTime}
		</if>
	</sql>

	<!--扩展查询条件-->
	<sql id="Base_Query_Condition_Extend">
		<if test="query.productNameFuzzy != null and query.productNameFuzzy != ''">
			and t.product_name like concat('%', #{query.productNameFuzzy}, '%')
		</if>
		<if test="query.productCodeFuzzy != null and query.productCodeFuzzy != ''">
			and t.product_code like concat('%', #{query.productCodeFuzzy}, '%')
		</if>
		<if test="query.categoryFuzzy != null and query.categoryFuzzy != ''">
			and t.category like concat('%', #{query.categoryFuzzy}, '%')
		</if>
		<if test="query.descriptionFuzzy != null and query.descriptionFuzzy != ''">
			and t.description like concat('%', #{query.descriptionFuzzy}, '%')
		</if>
		<if test="query.createTimeStart != null and query.createTimeStart != ''">
			and t.create_time >= str_to_date(#{query.createTimeStart}, '%Y-%m-%d')
		</if>
		<if test="query.createTimeEnd != null and query.createTimeEnd != ''">
			and t.create_time &lt; date_sub(str_to_date(#{query.createTimeEnd}, '%Y-%m-%d'), interval 1 day)
		</if>
	</sql>

	<!--通用查询条件-->
	<sql id="Query_Condition">
		<where>
			<include refid="Base_Query_Condition"/>
			<include refid="Base_Query_Condition_Extend"/>
		</where>
	</sql>

	<!--查询列表-->
	<select id="selectList" resultMap="base_result_map">
		SELECT <include refid="Base_Column_List"/> FROM ts_product_info t<include refid="Query_Condition"/>
		<if test="query.orderBy!=null and query.orderBy!=''">order by ${query.orderBy}</if>
		<if test="query.simplePage!=null">limit #{query.simplePage.start},#{query.simplePage.pageSize}</if>
	</select>

	<!--查询数量-->
