<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.easyjava.mappers.UserInfoMapper">
	<!--实体映射-->
	<resultMap id="base_result_map" type="com.easyjava.entity.po.UserInfo">
		<!--这是id-->
		<id column="id" property="id" javaType="Integer" />

		<!--用户昵称-->
		<result column="user_name" property="userName" javaType="String" />

		<!--商品名称-->
		<result column="product_name" property="productName" javaType="String" />

		<!--创建时间-->
		<result column="create_time" property="createTime" javaType="Date" />

		<!--硬币数量-->
		<result column="taotle" property="taotle" javaType="Integer" />

		<!--身份状态-->
		<result column="status" property="status" javaType="Integer" />

		<!--创建日期-->
		<result column="create_date" property="createDate" javaType="Date" />

		<!--用户是否存在，0：删除 1：正常-->
		<result column="is_del" property="isDel" javaType="Integer" />

	</resultMap>

	<!--通用查询结果列-->
	<sql id="Base_Column_List">
	id,user_name,product_name,create_time,taotle,status,create_date,is_del
	</sql>

	<!--基础查询条件-->
	<sql id="Base_Query_Condition">
		<if test="query.id != null">
			and id = #{query.id}
		</if>
		<if test="query.userName != null and query.userName!=''">
			and id = #{query.userName}
		</if>
		<if test="query.productName != null and query.productName!=''">
			and id = #{query.productName}
		</if>
		<if test="query.createTime != null">
			and id = #{query.createTime}
		</if>
		<if test="query.taotle != null">
			and id = #{query.taotle}
		</if>
		<if test="query.status != null">
			and id = #{query.status}
		</if>
		<if test="query.createDate != null">
			and id = #{query.createDate}
		</if>
		<if test="query.isDel != null">
			and id = #{query.isDel}
		</if>
	</sql>

	<!--扩展的查询条件-->
	<sql id="Base_Query_Condition_Extend">
		<if test="query.userNameFuzzy != null and query.userNameFuzzy !=''">
			 and user_name like concat('%', #{query.userNameFuzzy}, '%')
		</if>
		<if test="query.productNameFuzzy != null and query.productNameFuzzy !=''">
			 and product_name like concat('%', #{query.productNameFuzzy}, '%')
		</if>
		<if test="query.createTimeStart != null and query.createTimeStart !=''">
			and create_time >= str_to_date(#{query.createTimeStart}, '%Y-%m-%d')
		</if>
		<if test="query.createTimeEnd != null and query.createTimeEnd !=''">
			and create_time &lt; date_sub(str_to_date(#{query.createTimeEnd}, '%Y-%m-%d'),interval 1 day)
		</if>
		<if test="query.createDateStart != null and query.createDateStart !=''">
			and create_date >= str_to_date(#{query.createDateStart}, '%Y-%m-%d')
		</if>
		<if test="query.createDateEnd != null and query.createDateEnd !=''">
			and create_date &lt; date_sub(str_to_date(#{query.createDateEnd}, '%Y-%m-%d'),interval 1 day)
		</if>
	</sql>

	<!--扩展的查询结果列-->
	<sql id="Query_Condition">
		<where>
			<include refid="Base_Query_Condition"/>
			<include refid="Base_Query_Condition_Extend"/>
		</where>
	</sql>

	<!--查询列表-->
	<select id="selectList" resultMap="base_result_map">
		SELECT <include refid="Base_Column_List"/> FROM ts_user_info <include refid="Query_Condition"/>
		<if test="query.orderBy!=null">order by $(query.orderBy)</if>
		<if test="query.simplePage!=null">limit #(query.simplePage.start),#(query.simplePage.end)</if>
	</select>

	<!--查询数量-->
	<select id="selectCount" resultType="java.lang.Long">
		SELECT count(1) FROM ts_user_info <include refid="Query_Condition"/>
	</select>

	<!--单条插入(匹配有值的字段)-->
	<insert id="insert" parameterType="com.easyjava.entity.po.UserInfo" useGeneratedKeys="true" keyProperty="bean.id">
		INSERT INTO ts_user_info 

		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.id != null">
				id,
			</if>
			<if test="bean.userName != null">
				user_name,
			</if>
			<if test="bean.productName != null">
				product_name,
			</if>
			<if test="bean.createTime != null">
				create_time,
			</if>
			<if test="bean.taotle != null">
				taotle,
			</if>
			<if test="bean.status != null">
				status,
			</if>
			<if test="bean.createDate != null">
				create_date,
			</if>
			<if test="bean.isDel != null">
				is_del,
			</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.id != null">
				#{bean.id},
			</if>
			<if test="bean.userName != null">
				#{bean.userName},
			</if>
			<if test="bean.productName != null">
				#{bean.productName},
			</if>
			<if test="bean.createTime != null">
				#{bean.createTime},
			</if>
			<if test="bean.taotle != null">
				#{bean.taotle},
			</if>
			<if test="bean.status != null">
				#{bean.status},
			</if>
			<if test="bean.createDate != null">
				#{bean.createDate},
			</if>
			<if test="bean.isDel != null">
				#{bean.isDel},
			</if>
		</trim>
	</insert>

	<!--插入或更新(匹配有值的字段)-->
	<insert id="insertOrUpdate" parameterType="com.easyjava.entity.po.UserInfo" useGeneratedKeys="true" keyProperty="bean.id">
		INSERT INTO ts_user_info 
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.id != null">
				id,
			</if>
			<if test="bean.userName != null">
				user_name,
			</if>
			<if test="bean.productName != null">
				product_name,
			</if>
			<if test="bean.createTime != null">
				create_time,
			</if>
			<if test="bean.taotle != null">
				taotle,
			</if>
			<if test="bean.status != null">
				status,
			</if>
			<if test="bean.createDate != null">
				create_date,
			</if>
			<if test="bean.isDel != null">
				is_del,
			</if>
		</trim>
		VALUES
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.id != null">
				#{bean.id},
			</if>
			<if test="bean.userName != null">
				#{bean.userName},
			</if>
			<if test="bean.productName != null">
				#{bean.productName},
			</if>
			<if test="bean.createTime != null">
				#{bean.createTime},
			</if>
			<if test="bean.taotle != null">
				#{bean.taotle},
			</if>
			<if test="bean.status != null">
				#{bean.status},
			</if>
			<if test="bean.createDate != null">
				#{bean.createDate},
			</if>
			<if test="bean.isDel != null">
				#{bean.isDel},
			</if>
		</trim>
		ON DUPLICATE KEY UPDATE
		<trim suffixOverrides=",">
			<if test="bean.productName != null">
				product_name = VALUES(product_name),
			</if>
			<if test="bean.createTime != null">
				create_time = VALUES(create_time),
			</if>
			<if test="bean.taotle != null">
				taotle = VALUES(taotle),
			</if>
			<if test="bean.status != null">
				status = VALUES(status),
			</if>
			<if test="bean.createDate != null">
				create_date = VALUES(create_date),
			</if>
			<if test="bean.isDel != null">
				is_del = VALUES(is_del),
			</if>
		</trim>
	</insert>

	<!--批量插入-->
	<insert id="insertBatch" parameterType="java.util.List" useGeneratedKeys="true" keyProperty=".id">
		INSERT INTO ts_user_info( user_name,product_name,create_time,taotle,status,create_date,is_del )VALUES
		<foreach collection="list" item="item" separator="," open="(" close=")">
			#{item.userName},#{item.productName},#{item.createTime},#{item.taotle},#{item.status},#{item.createDate},#{item.isDel}
		</foreach>
	</insert>

	<!--批量插入或更新-->
	<insert id="insertOrUpdateBatch" parameterType="java.util.List" useGeneratedKeys="true" keyProperty=".id">
		INSERT INTO ts_user_info (user_name,product_name,create_time,taotle,status,create_date,is_del) VALUES
		<foreach collection="list" item="item" separator="," open="(" close=")">
			#{item.userName},#{item.productName},#{item.createTime},#{item.taotle},#{item.status},#{item.createDate},#{item.isDel}
		</foreach>
		ON DUPLICATE KEY UPDATE
		user_name = VALUES(user_name),product_name = VALUES(product_name),create_time = VALUES(create_time),taotle = VALUES(taotle),status = VALUES(status),create_date = VALUES(create_date),is_del = VALUES(is_del)
	</insert>
    /**
     * 根据Id查询
     */
	<select id="selectById" resultMap="base_result_map">
		SELECT <include refid="Base_Column_List"/> from ts_user_info where id=#{ id}
	</select>
    /**
     * 根据UserName查询
     */
	<select id="selectByUserName" resultMap="base_result_map">
		SELECT <include refid="Base_Column_List"/> from ts_user_info where userName=#{ userName}
	</select>
</mapper>
